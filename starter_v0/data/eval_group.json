{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_user_tweets_other_person",
      "phase": "B",
      "suite": "group",
      "query": "Gần đây Satya Nadella đăng gì trên Twitter?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "satyanadella"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_user_tweets_name_to_handle",
        "difficulty": "medium",
        "what_it_tests": "Tin CỦA một người cụ thể (Satya Nadella) → timeline với handle satyanadella, không dùng social_search."
      }
    },
    {
